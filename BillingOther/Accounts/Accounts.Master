<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Accounts.master.cs" Inherits="BillingOther.Accounts.Accounts" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Infinity IPS | Billing Portal</title>
    <link rel="stylesheet" href="../css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="../css/fontawesome/font-awesome.min.css" />
    <link rel="stylesheet" href="../css/portal.css?v=3" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="portal-body">
    <form id="form1" runat="server">
        <asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server" EnablePageMethods="true" />
        <header class="portal-header">
            <nav class="portal-navbar portal-shell" aria-label="Primary navigation">
                <a class="portal-brand" href="Dashboard.aspx">
                    <img src="../Images/logo.png" alt="Infinity IPS" /><span class="portal-brand-copy"><strong>Infinity IPS</strong><small>Billing Portal</small></span></a>
                <button type="button" class="portal-menu-toggle" aria-controls="portalNav" aria-expanded="false"><i class="fa fa-bars"></i><span class="sr-only">Toggle navigation</span></button>
                <ul id="portalNav" class="portal-nav">
                    <li><a href="Dashboard.aspx"><i class="fa fa-dashboard"></i>Dashboard</a></li>
                    <li class="has-dropdown"><a href="#"><i class="fa fa-database"></i>Masters <i class="fa fa-angle-down"></i></a>
                        <ul class="portal-dropdown">
                            <li><a href="ProjectDetailsMaster.aspx">Client Billing Template</a></li>
                            <li><a href="ClientEmailConfiguration.aspx">Client Email Configuration</a></li>
                            <li><a href="VerifyCostMaster.aspx">Verify Price</a></li>
                            <li><a href="ProjectGroupMaster.aspx">Project Group</a></li>
                            <li><a href="ProductMaster.aspx">Product Master</a></li>
                            <li><a href="ProductMapping.aspx">Product Mapping</a></li>
                            <li><a href="WholeLoanBilling.aspx">Import Whole Loan Billing</a></li>
                        </ul>
                    </li>
                    <li class="has-dropdown"><a href="#"><i class="fa fa-file-text-o"></i>Billing <i class="fa fa-angle-down"></i></a>
                        <ul class="portal-dropdown">
                            <li><a href="SendAccountDetails.aspx">Yet To Be Billed</a></li>
                            <li><a href="SendToClient.aspx">Sent to Client</a></li>
                            <li><a href="SummaryReport.aspx">Sent To Client - Summary</a></li>
                        </ul>
                    </li>
                    <li class="has-dropdown"><a href="#"><i class="fa fa-bar-chart"></i>Reports <i class="fa fa-angle-down"></i></a>
                        <ul class="portal-dropdown">
                            <%--<li><a href="MasterReport.aspx">All Domain Master Report</a></li>--%>
                            <li><a href="ProjectwisePriceMaster.aspx">Project wise Price Details</a></li>
                            <li><a href="AllProjectBillingReport.aspx">All Project Billing Details</a></li>
                            <%--<li><a href="CostPerRecord.aspx">Cost Per Record Report</a></li>--%>
                            <li><a href="DeviationReport.aspx">Deviation Report</a></li>
                            <li><a href="ProjectSummaryReport.aspx">Project Summary Report</a></li>
                            <li><a href="RateRevisionUpdates.aspx">Rate Revision History</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="portal-user">
                    <div class="portal-user-name"><span id="spnUsername" runat="server"></span></div>
                    <a class="portal-logout" href="../Logout.aspx" title="Sign out" aria-label="Sign out"><i class="fa fa-sign-out"></i></a></div>
            </nav>
        </header>
        <main class="portal-main">
            <div class="portal-shell">
                <header class="portal-page-header"><span class="portal-page-eyebrow">Infinity IPS Billing</span><h1 id="lblHeader" runat="server">Dashboard</h1>
                </header>
                <section class="portal-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
                </section>
            </div>
        </main>
        <footer class="portal-footer">
            <div class="portal-shell"><strong>Infinity IPS</strong><span>Billing Portal</span></div>
        </footer>
        <div id="portalLoading" class="portal-loading" aria-hidden="true" aria-live="polite">
            <div class="portal-loading-card"><span class="portal-spinner"></span><span>Processing, please wait…</span></div>
        </div>
    </form>
    <script src="../js/plugins/jquery/jquery.min.js"></script>
    <script src="../js/plugins/bootstrap/bootstrap.min.js"></script>
    <script src="../js/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="../js/portal.js?v=1"></script>
</body>
</html>
