<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Infinity IPS | Billing Portal</title>
<link rel="stylesheet" href="../css/bootstrap/bootstrap.min.css" /><link rel="stylesheet" href="../css/fontawesome/font-awesome.min.css" /><link rel="stylesheet" href="../css/portal.css?v=3" /><asp:ContentPlaceHolder ID="head" runat="server" /></head>
<body class="portal-body"><form id="form1" runat="server"><asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server" EnablePageMethods="true" />
<header class="portal-header"><nav class="portal-navbar portal-shell" aria-label="Primary navigation"><a class="portal-brand" href="CostPerRecord.aspx"><img src="../Images/logo.png" alt="Infinity IPS" /><span class="portal-brand-copy"><strong>Infinity IPS</strong><small>Billing Portal</small></span></a><button type="button" class="portal-menu-toggle" aria-controls="portalNav" aria-expanded="false"><i class="fa fa-bars"></i><span class="sr-only">Toggle navigation</span></button><ul id="portalNav" class="portal-nav"><li><a href="CostPerRecord.aspx"><i class="fa fa-table"></i>Cost Per Record</a></li><li><a href="WholeLoanBilling.aspx"><i class="fa fa-file-excel-o"></i>Whole Loan Billing</a></li></ul><div class="portal-user"><div class="portal-user-name"><span id="spnUsername" runat="server"></span></div><a class="portal-logout" href="../Logout.aspx" title="Sign out" aria-label="Sign out"><i class="fa fa-sign-out"></i></a></div></nav></header>
<main class="portal-main"><div class="portal-shell"><header class="portal-page-header"><span class="portal-page-eyebrow">Infinity IPS Billing</span><h1 id="lblHeader" runat="server">Billing</h1></header><section class="portal-content"><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" /></section></div></main><footer class="portal-footer"><div class="portal-shell"><strong>Infinity IPS</strong><span>Billing Portal</span></div></footer><div id="portalLoading" class="portal-loading" aria-hidden="true" aria-live="polite"><div class="portal-loading-card"><span class="portal-spinner"></span><span>Processing, please wait…</span></div></div></form>
<script src="../js/plugins/jquery/jquery.min.js"></script><script src="../js/plugins/bootstrap/bootstrap.min.js"></script><script src="../js/plugins/datatables/jquery.dataTables.min.js"></script><script src="../js/portal.js?v=1"></script></body></html>
