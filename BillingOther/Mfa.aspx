<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Mfa.aspx.cs" Inherits="BillingOther.Mfa" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Verify your identity | Infinity IPS</title><link rel="stylesheet" href="css/fontawesome/font-awesome.min.css" /><link rel="stylesheet" href="css/portal.css?v=1" /></head>
<body class="portal-login"><main class="login-layout"><section class="login-intro" aria-label="Secure sign in"><div class="login-intro-content"><img src="Images/logo.png" alt="Infinity IPS" /><p class="login-eyebrow">SECURE ACCESS</p><h1>One more<br />step.</h1><p class="login-summary">Multi-factor authentication protects billing data even if a password is compromised.</p></div></section>
<section class="login-panel"><div class="login-card"><div class="login-mobile-brand"><img src="Images/logo.png" alt="Infinity IPS" /><strong>Infinity IPS</strong></div><p class="login-kicker">IDENTITY VERIFICATION</p><h2><asp:Literal ID="litHeading" runat="server" /></h2><p class="login-help"><asp:Literal ID="litInstructions" runat="server" /></p><form id="form1" runat="server"><div id="dvError" runat="server" role="alert"></div>
<asp:Panel ID="pnlSetup" runat="server" Visible="false"><div class="login-field"><label>Authenticator setup key</label><div class="mfa-secret"><asp:Literal ID="litSecret" runat="server" /></div><p class="login-help">Add this key to Microsoft Authenticator, Google Authenticator, or another TOTP app.</p></div></asp:Panel>
<div class="login-field"><label for="otpCode">6-digit verification code</label><div class="login-input"><i class="fa fa-key"></i><input id="otpCode" name="otpCode" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required placeholder="000000" /></div></div><asp:Button ID="btnVerify" runat="server" Text="Verify and continue" CssClass="login-button" OnClick="btnVerify_Click" /></form><p class="login-note"><a href="Logout.aspx">Cancel and sign out</a></p></div></section></main></body></html>
