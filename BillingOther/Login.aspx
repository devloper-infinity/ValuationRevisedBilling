<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="BillingOther.Login" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Sign in | Infinity IPS</title><link rel="stylesheet" href="css/fontawesome/font-awesome.min.css" /><link rel="stylesheet" href="css/portal.css?v=1" /></head>
<body class="portal-login"><main class="login-layout">
<section class="login-intro" aria-label="Infinity IPS Billing Portal"><div class="login-intro-content"><img src="<%= ResolveUrl("~/Images/logo.png") %>?v=20260929" alt="Infinity IPS Client Billing" /><p class="login-eyebrow">INFINITY IPS</p><h1>Billing,<br />made clear.</h1><p class="login-summary">A secure workspace for billing operations, costing configuration, invoice tracking, and management reporting.</p><div class="login-features"><span><i class="fa fa-line-chart"></i> Management reports</span><span><i class="fa fa-file-text-o"></i> Billing workflows</span><span><i class="fa fa-shield"></i> Secure access</span></div></div></section>
<section class="login-panel"><div class="login-card"><div class="login-mobile-brand"><img src="<%= ResolveUrl("~/Images/logo.png") %>?v=20260929" alt="Infinity IPS Client Billing" /><strong>Infinity IPS</strong></div><p class="login-kicker">WELCOME BACK</p><h2>Sign in to your account</h2><p class="login-help">Enter your credentials to continue to the Billing Portal.</p>
<form id="form1" runat="server" method="post"><div id="dvError" runat="server" role="alert"></div>
<div class="login-field"><label for="txtUserName">Username</label><div class="login-input"><i class="fa fa-user"></i><asp:TextBox ID="txtUserName" runat="server" ClientIDMode="Static" placeholder="Enter username" autocomplete="username" /></div><asp:RequiredFieldValidator ID="rfv_txtUserName" runat="server" ControlToValidate="txtUserName" ErrorMessage="Please enter username" Display="Dynamic" CssClass="validation-error" /></div>
<div class="login-field"><label for="txtPassword">Password</label><div class="login-input"><i class="fa fa-lock"></i><asp:TextBox ID="txtPassword" runat="server" ClientIDMode="Static" placeholder="Enter password" TextMode="Password" autocomplete="current-password" /></div><asp:RequiredFieldValidator ID="rfv_txtPassword" runat="server" ControlToValidate="txtPassword" ErrorMessage="Please enter password" Display="Dynamic" CssClass="validation-error" /></div>
<div class="login-options"><label><asp:CheckBox ID="chkRemember" runat="server" /> Remember me</label></div><asp:Button ID="btnLogin" runat="server" Text="Sign in" CssClass="login-button" OnClick="btnSubmit_Click" />
</form><p class="login-note"><i class="fa fa-lock"></i> Your connection is protected and monitored.</p></div></section>
</main></body></html>
